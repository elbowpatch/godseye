{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15,
      "memory": 1024
    },
    "api/overpass.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/route.js": {
      "maxDuration": 20,
      "memory": 1024
    },
    "api/cctv/**/*.js": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "config/**"
    },
    "api/celestrak/*.js": {
      "maxDuration": 20
    },
    "api/launches.js": {
      "maxDuration": 20
    },
    "api/firms/*.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/terrain/heights.js": {
      "maxDuration": 30
    },
    "api/radio/stations.js": {
      "maxDuration": 30
    }
  }
}
